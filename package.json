{
  "name": "onyx-grid-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ONYX GRID local broadcast control desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.onyxgrid.desktop",
    "productName": "ONYX GRID",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "local-server.cjs",
      "render-preview/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}